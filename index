<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thumbnail Previewer</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%20%3Cdefs%3E%20%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%20%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23ff6a2b%22%2F%3E%20%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23ffb03a%22%2F%3E%20%3C%2FlinearGradient%3E%20%3C%2Fdefs%3E%20%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22url%28%23g%29%22%2F%3E%20%3Cpath%20d%3D%22M25%2019.5c0-1.7%201.9-2.8%203.4-1.9l19%2012.4a2.2%202.2%200%200%201%200%203.8l-19%2012.4c-1.5.9-3.4-.2-3.4-1.9z%22%20fill%3D%22%23fff%22%2F%3E%20%3C%2Fsvg%3E">
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<meta name="theme-color" content="#ff8a2b">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Roboto+Condensed:wght@700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0a0a;--panel:#161616;--panel-2:#1e1e1e;--line:#2a2a2a;
    --text:#f1f1f1;--muted:#a3a3a3;--muted-2:#717171;
    --accent-a:#ff6a2b;--accent-b:#ffb03a;--accent:#ff8a2b;
    --yt-text:#f1f1f1;--yt-muted:#aaa;--yt-bg:#0f0f0f;
  }
  .preview-stage.light{--yt-text:#0f0f0f;--yt-muted:#606060;--yt-bg:#ffffff;}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:var(--bg);color:var(--text);font-family:'Roboto',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
  body{padding:28px 20px 80px;min-height:100vh}
  .wrap{max-width:1180px;margin:0 auto}

  .brand{display:flex;align-items:center;gap:10px;margin-bottom:22px;flex-wrap:wrap}
  .brand .logo{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent-a),var(--accent-b));font-size:18px}
  .brand h1{font-size:19px;font-weight:700;letter-spacing:-.2px}
  .brand span{color:var(--muted-2);font-weight:400;font-size:13px;margin-left:2px}

  .card{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:22px}
  .card-head{display:flex;align-items:center;gap:9px;font-weight:700;font-size:15px;margin-bottom:18px}

  .config{display:grid;grid-template-columns:300px 1fr;gap:20px}
  @media(max-width:720px){.config{grid-template-columns:1fr}}

  .drop{border:2px dashed #6b4a2e;border-radius:14px;background:#141414;min-height:230px;display:grid;place-content:center;justify-items:center;text-align:center;padding:20px;cursor:pointer;transition:.18s;position:relative;overflow:hidden}
  .drop:hover{border-color:var(--accent);background:#171310}
  .drop.drag{border-color:var(--accent);background:#1a140e}
  .drop .cloud{font-size:34px;margin-bottom:12px}
  .drop b{font-size:18px;font-weight:700}
  .drop small{color:var(--muted-2);font-size:13px;margin-top:8px;max-width:220px;line-height:1.4}
  .drop.filled{padding:0;border-style:solid;border-color:var(--line)}
  .drop.filled img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .drop .replace{position:absolute;inset:0;background:rgba(0,0,0,.55);color:#fff;display:grid;place-content:center;opacity:0;transition:.18s;font-weight:600}
  .drop.filled:hover .replace{opacity:1}

  .fields{display:flex;flex-direction:column;gap:16px}
  .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:500;color:#d0d0d0;margin-bottom:7px}
  .field label .count{color:var(--muted-2);font-weight:400}
  .inp{width:100%;background:#101010;border:1px solid var(--line);color:var(--text);border-radius:11px;padding:13px 14px;font-size:15px;font-family:inherit;transition:.15s}
  .inp::placeholder{color:#5c5c5c}
  .inp:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,138,43,.12)}
  .row{display:grid;grid-template-columns:1fr 150px;gap:14px}
  @media(max-width:560px){.row{grid-template-columns:1fr}}

  .logo-row{display:flex;align-items:center;gap:12px}
  .logo-pick{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:#101010;display:grid;place-items:center;cursor:pointer;overflow:hidden;flex:0 0 auto;font-size:18px;color:var(--muted-2)}
  .logo-pick img{width:100%;height:100%;object-fit:cover}
  .logo-hint{font-size:12px;color:var(--muted-2);line-height:1.4}

  .adv-toggle{display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-size:14px;font-weight:500;cursor:pointer;user-select:none;margin-top:2px;width:max-content}
  .adv-toggle .chev{transition:.2s}
  .adv-toggle.open .chev{transform:rotate(180deg)}
  .adv{display:none;grid-template-columns:1fr 1fr;gap:14px;margin-top:4px}
  .adv.open{display:grid}
  @media(max-width:560px){.adv{grid-template-columns:1fr}}
  .check{display:flex;align-items:center;gap:9px;font-size:14px;color:#d0d0d0;cursor:pointer;padding-top:6px}
  .check input{width:17px;height:17px;accent-color:var(--accent)}

  .gen{margin-top:20px;width:100%;border:none;border-radius:14px;padding:17px;font-size:17px;font-weight:700;font-family:inherit;color:#fff;cursor:pointer;background:linear-gradient(90deg,var(--accent-a),var(--accent-b));display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 8px 30px -8px rgba(255,120,40,.6);transition:.15s}
  .gen:hover{filter:brightness(1.05);transform:translateY(-1px)}
  .gen:active{transform:translateY(0)}

  .prev-top{margin-top:26px;display:flex;flex-direction:column;gap:16px}
  .tabs{display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:6px}
  .tab{flex:1;border:none;background:none;color:var(--muted);font-family:inherit;font-size:14px;font-weight:600;padding:11px 8px;border-radius:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:.15s}
  .tab:hover{color:var(--text)}
  .tab.active{background:linear-gradient(90deg,var(--accent-a),var(--accent-b));color:#fff}
  .tab .ti{font-size:15px}
  @media(max-width:620px){.tab span{display:none}.tab{padding:11px}}

  .prev-controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .pill{display:inline-flex;align-items:center;gap:7px;background:var(--panel-2);border:1px solid var(--line);color:#d0d0d0;font-family:inherit;font-size:13px;font-weight:500;padding:9px 15px;border-radius:999px;cursor:pointer;transition:.15s}
  .pill:hover{border-color:#3d3d3d;background:#242424}
  .pill.on{color:var(--accent);border-color:#5c3a1e;background:#1c140c}
  .pill.ghost-accent{color:#5bd47a;border-color:#2a4a34}
  .pill.ghost-accent:hover{background:#14241a}
  .spacer{flex:1}

  .preview-stage{margin-top:20px;background:var(--yt-bg);border:1px solid var(--line);border-radius:18px;padding:26px;min-height:420px;transition:background .2s}
  .preview-stage.light{border-color:#e5e5e5}
  .empty{display:grid;place-items:center;min-height:360px;text-align:center;color:var(--muted-2)}
  .empty .big{font-size:46px;margin-bottom:14px}
  .empty b{color:var(--text);font-weight:600;font-size:17px}
  .empty p{margin-top:6px;font-size:14px;max-width:340px}

  /* YouTube card primitives */
  .yt-thumb{position:relative;width:100%;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#222}
  .yt-thumb svg,.yt-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .yt-dur{position:absolute;right:8px;bottom:8px;background:rgba(0,0,0,.82);color:#fff;font-size:12px;font-weight:600;padding:2px 5px;border-radius:5px;line-height:1.3;letter-spacing:.3px}
  .yt-title{color:var(--yt-text);font-weight:500;font-size:15px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .yt-chan{color:var(--yt-muted);font-size:13px;margin-top:3px;display:flex;align-items:center;gap:5px}
  .yt-meta{color:var(--yt-muted);font-size:13px}
  .yt-av{width:36px;height:36px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;color:#fff;font-weight:700;font-size:15px;overflow:hidden;position:relative}
  .yt-av img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  .verified{width:14px;height:14px;flex:0 0 auto;opacity:.8}

  .badge-mine{position:absolute;top:-11px;left:8px;z-index:3;background:linear-gradient(90deg,var(--accent-a),var(--accent-b));color:#fff;font-size:11px;font-weight:700;letter-spacing:.4px;padding:4px 10px;border-radius:999px;display:flex;align-items:center;gap:5px;box-shadow:0 4px 14px -4px rgba(255,120,40,.7)}
  .mine .yt-thumb{outline:3px solid var(--accent);outline-offset:2px}
  @keyframes pop{0%{transform:scale(.98)}60%{transform:scale(1.012)}100%{transform:scale(1)}}
  .flash{animation:pop .5s ease}

  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px 16px}
  @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.grid{grid-template-columns:1fr}}
  .gcard .row2{display:flex;gap:12px;margin-top:11px}
  .gcard .row2 .txt{min-width:0}
  .gcard,.mcard,.tvcard{position:relative}

  .search-list{display:flex;flex-direction:column;gap:18px;max-width:860px;margin:0 auto}
  .srow{display:grid;grid-template-columns:360px 1fr;gap:16px;position:relative}
  @media(max-width:680px){.srow{grid-template-columns:1fr}}
  .srow .yt-title{font-size:18px}
  .srow .schan{display:flex;align-items:center;gap:8px;margin:10px 0}
  .srow .sdesc{color:var(--yt-muted);font-size:13px;line-height:1.5;margin-top:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .srow .smeta{color:var(--yt-muted);font-size:13px;margin-top:2px}

  .phone{width:340px;max-width:100%;margin:0 auto;background:#000;border:11px solid #050505;border-radius:44px;box-shadow:0 30px 70px -20px rgba(0,0,0,.8);position:relative}
  .phone .notch{position:absolute;top:9px;left:50%;transform:translateX(-50%);width:120px;height:26px;background:#050505;border-radius:0 0 16px 16px;z-index:5}
  .phone .screen{background:var(--yt-bg);border-radius:33px;overflow:hidden;max-height:640px;overflow-y:auto;padding:22px 12px 26px}
  .phone .screen::-webkit-scrollbar{width:5px}
  .phone .screen::-webkit-scrollbar-thumb{background:#555;border-radius:3px}
  .mfeed{display:flex;flex-direction:column;gap:22px}
  .mcard .row2{display:flex;gap:11px;margin-top:10px}
  .mcard.mine{border:2px solid var(--accent);border-radius:14px;padding:10px;margin:0 -2px}
  .mcard.mine .yt-thumb{outline:none}
  .mcard.mine .badge-mine{top:0;left:2px}

  .tv{background:#000;border:14px solid #0b0b0b;border-radius:16px;box-shadow:0 30px 60px -20px rgba(0,0,0,.7);overflow:hidden}
  .tv .screen{background:var(--yt-bg);padding:26px 22px}
  .tv-row-title{color:var(--yt-text);font-size:16px;font-weight:700;margin-bottom:14px}
  .tv-scroll{display:flex;gap:16px;overflow-x:auto;padding-bottom:10px}
  .tv-scroll::-webkit-scrollbar{height:6px}
  .tv-scroll::-webkit-scrollbar-thumb{background:#555;border-radius:3px}
  .tvcard{flex:0 0 300px;max-width:300px}
  .tvcard .yt-title{font-size:14px;margin-top:9px}
  @media(max-width:560px){.tvcard{flex:0 0 240px}}

  .compare{display:flex;flex-direction:column;gap:30px}
  .cmp-block b.lbl{display:block;color:var(--yt-muted);font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;margin-bottom:12px}
  .cmp-sizes{display:flex;gap:24px;align-items:flex-end;flex-wrap:wrap}
  .cmp-item{text-align:center}
  .cmp-item span{display:block;color:var(--yt-muted);font-size:12px;margin-top:8px}
  .cw-360{width:360px}.cw-246{width:246px}.cw-168{width:168px}.cw-100{width:100px}
  @media(max-width:560px){.cw-360{width:100%}}

  .cmp-uploads{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
  .ab-slot{position:relative;border:2px dashed #3a3a42;border-radius:14px;min-height:110px;background:#17171b;display:grid;place-items:center;cursor:pointer;overflow:hidden;text-align:center;transition:.15s}
  .ab-slot:hover{border-color:var(--accent)}
  .ab-slot>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ab-slot .ph{color:#9a9aa2;font-size:13px;line-height:1.5;padding:16px}
  .ab-slot .ph b{color:#d6d6d6}.ab-slot .ph small{color:#6a6a72}
  .ab-slot .replace{position:absolute;inset:0;background:rgba(0,0,0,.55);color:#fff;display:grid;place-content:center;opacity:0;transition:.15s;font-weight:600}
  .ab-slot:hover .replace{opacity:1}
  .ab-head{position:absolute;top:9px;left:9px;z-index:2}
  .ab-badge{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;color:#fff;font-weight:700;font-size:13px;line-height:1}
  .ab-badge.a{background:linear-gradient(135deg,#ff6a2b,#ffb03a)}
  .ab-badge.b{background:linear-gradient(135deg,#8b5cf6,#a855f7)}
  .cmp-phones{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;justify-items:center}
  .cmp-col{width:100%;max-width:320px}
  .cmp-col .phone{width:100%}
  .cmp-col .ab-label{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px;color:var(--yt-text);margin-bottom:12px}
  @media(max-width:760px){.cmp-uploads,.cmp-phones{grid-template-columns:1fr}}
  .foot{max-width:1180px;margin:26px auto 0;color:var(--muted-2);font-size:12.5px;line-height:1.6;text-align:center}
  .hidden-file{display:none}
</style>
</head>
<body>
<div class="wrap">

  <div class="brand">
    <div class="logo">🎬</div>
    <h1>Thumbnail Previewer</h1>
    <span>· see your thumbnail in the real feed before you publish</span>
  </div>

  <div class="card">
    <div class="card-head"><span>🖼️</span> Upload &amp; Configure</div>
    <div class="config">
      <div class="drop" id="drop">
        <input type="file" id="thumbFile" class="hidden-file" accept="image/png,image/jpeg,image/webp">
        <div class="cloud">☁️⬆️</div>
        <b>Click or Drop Thumbnail</b>
        <small>PNG, JPG up to a few MB · 1280×720 recommended</small>
        <div class="replace">Click to replace</div>
      </div>

      <div class="fields">
        <div class="field">
          <label>Video Title <span class="count"><span id="titleCount">0</span>/100</span></label>
          <input class="inp" id="title" maxlength="100" placeholder="How I Grew to 100K Subscribers in 6 Months">
        </div>
        <div class="row">
          <div class="field"><label>Channel Name</label><input class="inp" id="channel" value="JT Franco"></div>
          <div class="field"><label>Duration</label><input class="inp" id="duration" value="12:34"></div>
        </div>
        <div class="field">
          <label>Channel Logo</label>
          <div class="logo-row">
            <div class="logo-pick" id="logoPick"><input type="file" id="logoFile" class="hidden-file" accept="image/*"></div>
            <div class="logo-hint">Your logo is set as the default.<br>Click the circle to use a different one.</div>
          </div>
        </div>
        <div class="adv-toggle" id="advToggle"><span class="chev">⌄</span> Advanced Options</div>
        <div class="adv" id="adv">
          <div class="field"><label>Views</label><input class="inp" id="views" value="184K"></div>
          <div class="field"><label>Uploaded</label><input class="inp" id="age" value="3 hours ago"></div>
          <label class="check"><input type="checkbox" id="verified" checked> Verified channel badge</label>
        </div>
      </div>
    </div>
    <button class="gen" id="generate">⚡ Generate Preview</button>
  </div>

  <div class="prev-top">
    <div class="tabs" id="tabs">
      <button class="tab active" data-view="desktop"><span class="ti">🖥️</span><span>Desktop</span></button>
      <button class="tab" data-view="search"><span class="ti">🔍</span><span>Search</span></button>
      <button class="tab" data-view="mobile"><span class="ti">📱</span><span>Mobile</span></button>
      <button class="tab" data-view="tv"><span class="ti">📺</span><span>TV</span></button>
      <button class="tab" data-view="compare"><span class="ti">🔲</span><span>Compare</span></button>
    </div>
    <div class="prev-controls">
      <button class="pill" id="themeBtn">🌙 <span>Dark</span></button>
      <button class="pill" id="shuffleBtn">🔀 Shuffle</button>
      <button class="pill" id="highlightBtn">◎ Find mine</button>
      <div class="spacer"></div>
      <button class="pill ghost-accent" id="shotBtn">📷 Screenshot</button>
    </div>
  </div>

  <div class="preview-stage light" id="stage">
    <div class="empty" id="empty">
      <div class="big">🎬</div>
      <b>Your preview will appear here</b>
      <p>Add a thumbnail and title, then hit <strong>Generate Preview</strong> to see it blend into a real YouTube feed. Use <strong>Find mine</strong> if you need help spotting it.</p>
    </div>
    <div id="render"></div>
  </div>
</div>
<input type="file" id="fileA" class="hidden-file" accept="image/*"><input type="file" id="fileB" class="hidden-file" accept="image/*">

<p class="foot">
  Runs entirely in your browser — nothing is uploaded anywhere. Surrounding videos are real reference thumbnails, embedded in this file for context.<br>
  Your logo loads from your link when you're online; offline it falls back to a letter avatar. Screenshot uses html2canvas from a CDN.
</p>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
(function(){
  "use strict";

  const LOGO_URL = "https://assets.cdn.filesafe.space/YNpmhBkj757KZhCfbF69/media/6a5b9ece1097b811953e1db4.png";

  const state = {
    thumb:null, logo:LOGO_URL,
    title:"", channel:"JT Franco", duration:"12:34",
    views:"184K", age:"3 hours ago", verified:true,
    view:"desktop", light:true, generated:false, highlight:false, thumbA:null, thumbB:null
  };

  const esc = s => (s==null?"":String(s)).replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
  const AV_COLORS=["#e0574a","#4a7de0","#5bb85b","#b455d6","#e0a23a","#3ab5c4","#d6556f","#7a5be0","#c2683a","#4aa3a3"];

  // ---- realistic mock thumbnail templates (original, SVG-drawn) ----
  const S = `preserveAspectRatio="xMidYMid slice" width="100%" height="100%" viewBox="0 0 320 180"`;
  function bigText(x,y,size,txt,fill,stroke,anchor){
    return `<text x="${x}" y="${y}" text-anchor="${anchor||'start'}" font-family="'Roboto Condensed','Roboto',sans-serif" font-weight="900" font-size="${size}" fill="${fill||'#fff'}" style="paint-order:stroke;stroke:${stroke||'#000'};stroke-width:${Math.max(2,size/7)}px;stroke-linejoin:round">${txt}</text>`;
  }

  function decoyThumb(img,dur){ return `<div class="yt-thumb"><img src="${img}" alt="thumbnail" loading="lazy"><div class="yt-dur">${dur}</div></div>`; }
  function avatar(name,i){ const c=AV_COLORS[i%AV_COLORS.length]; const l=(name||"?").trim().charAt(0).toUpperCase()||"?"; return `<div class="yt-av" style="background:${c}">${l}</div>`; }

  const DECOYS=[
    {img:"data:image/jpeg;base64,", t:"If You Feel Lost in Life, Watch This Tonight", c:"Quiet Mind", v:"393K views", a:"7 months ago", d:"2:42"},
    {img:"data:image/jpeg;base64,", t:"The Genius Marketing Nobody Talks About", c:"Growth Lab", v:"210K views", a:"6 months ago", d:"14:22"},
    {img:"data:image/jpeg;base64,", t:"Top Creator Live Trading Loss Reactions", c:"Market Raw", v:"98.7K views", a:"11 months ago", d:"34:03"},
    {img:"data:image/jpeg;base64,", t:"Why I'm Ditching My Production Company", c:"Ross Made", v:"96K views", a:"9 months ago", d:"12:17"},
    {img:"data:image/jpeg;base64,", t:"AI Steals More Than Just Your Stories", c:"Westwood Writes", v:"131K views", a:"1 year ago", d:"8:20"},
    {img:"data:image/jpeg;base64,", t:"I'm 29 and I Wasted My 20s", c:"Anna Speaks", v:"945K views", a:"1 year ago", d:"9:37"},
    {img:"data:image/jpeg;base64,", t:"Don't Enter 2026 Without These 6 Habits", c:"Break Free", v:"322K views", a:"7 months ago", d:"4:00"}
  ];
  let deck = DECOYS.slice();
  function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]];}}

  // ---- user's card ----
  const VERIFIED=`<svg class="verified" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 1.8 3-.2 1 2.9 2.6 1.6-.9 2.9.9 2.9-2.6 1.6-1 2.9-3-.2L12 22l-2.4-1.8-3 .2-1-2.9L3 14.1l.9-2.9L3 8.3l2.6-1.6 1-2.9 3 .2L12 2zm-1.1 13.4l5-5-1.3-1.3-3.7 3.7-1.8-1.8L7.8 12l3.1 3.4z"/></svg>`;
  function userThumb(imgOverride, phText){
    const img = imgOverride!==undefined ? imgOverride : state.thumb;
    const dur=`<div class="yt-dur">${esc(state.duration)||"0:00"}</div>`;
    if(img) return `<div class="yt-thumb"><img src="${img}" alt="thumbnail">${dur}</div>`;
    const t=esc((state.title||"Your Video Title Here").slice(0,46));
    return `<div class="yt-thumb"><svg ${S}><rect width="320" height="180" fill="#1c1c22"/><text x="160" y="96" text-anchor="middle" font-family="Roboto" font-weight="700" font-size="16" fill="#8a8a94">${t}</text><text x="160" y="120" text-anchor="middle" font-family="Roboto" font-size="10" fill="#5a5a62">${esc(phText||"ADD YOUR THUMBNAIL ↑")}</text></svg>${dur}</div>`;
  }
  function userAvatar(){
    const letter=(state.channel||"J").trim().charAt(0).toUpperCase()||"J";
    if(state.logo) return `<div class="yt-av" style="background:#c0392b"><span style="position:absolute">${letter}</span><img src="${state.logo}" alt="logo" onerror="this.remove()"></div>`;
    return `<div class="yt-av" style="background:#c0392b">${letter}</div>`;
  }
  const uTitle=()=>esc(state.title||"Your Video Title Goes Here");
  const uChan=()=>esc(state.channel||"Your Channel");
  const uMeta=()=>`${esc(state.views)||"0 views"} · ${esc(state.age)||"just now"}`;
  const uVer=()=>state.verified?VERIFIED:"";
  const badge=()=>state.highlight?`<div class="badge-mine">★ YOUR THUMBNAIL</div>`:"";
  const mineCls=()=>state.highlight?" mine flash":"";
  function scaleAv(html){return html.replace('class="yt-av"','class="yt-av" style="width:24px;height:24px;font-size:11px"');}

  function buildDeck(pos){ const out=deck.map((d,i)=>({d,i})); out.splice(Math.min(pos,out.length),0,{mine:true}); return out; }

  // ---- renderers ----
  function renderDesktop(){
    return `<div class="grid">`+buildDeck(2).map(it=>{
      if(it.mine) return `<div class="gcard${mineCls()}">${badge()}${userThumb()}<div class="row2">${userAvatar()}<div class="txt"><div class="yt-title">${uTitle()}</div><div class="yt-chan">${uChan()} ${uVer()}</div><div class="yt-meta">${uMeta()}</div></div></div></div>`;
      const d=it.d; return `<div class="gcard">${decoyThumb(d.img,d.d)}<div class="row2">${avatar(d.c,it.i)}<div class="txt"><div class="yt-title">${esc(d.t)}</div><div class="yt-chan">${esc(d.c)}</div><div class="yt-meta">${esc(d.v)} · ${esc(d.a)}</div></div></div></div>`;
    }).join("")+`</div>`;
  }
  function renderSearch(){
    return `<div class="search-list">`+buildDeck(1).slice(0,6).map(it=>{
      if(it.mine) return `<div class="srow${mineCls()}"><div style="position:relative">${badge()}${userThumb()}</div><div><div class="yt-title">${uTitle()}</div><div class="smeta">${uMeta()}</div><div class="schan">${scaleAv(userAvatar())}<span class="yt-meta">${uChan()} ${uVer()}</span></div><div class="sdesc">Your description preview shows here in search — write something that earns the click.</div></div></div>`;
      const d=it.d; return `<div class="srow"><div>${decoyThumb(d.img,d.d)}</div><div><div class="yt-title">${esc(d.t)}</div><div class="smeta">${esc(d.v)} · ${esc(d.a)}</div><div class="schan">${scaleAv(avatar(d.c,it.i))}<span class="yt-meta">${esc(d.c)}</span></div><div class="sdesc">A quick look at what this video covers, pulled from the description for context.</div></div></div>`;
    }).join("")+`</div>`;
  }
  function mobileFeed(thumbOverride, phText){
    return `<div class="phone"><div class="notch"></div><div class="screen"><div class="mfeed">`+buildDeck(1).map(it=>{
      if(it.mine) return `<div class="mcard${mineCls()}"><div style="position:relative">${badge()}${userThumb(thumbOverride,phText)}</div><div class="row2">${userAvatar()}<div class="txt"><div class="yt-title">${uTitle()}</div><div class="yt-chan">${uChan()} ${uVer()}</div><div class="yt-meta">${uMeta()}</div></div></div></div>`;
      const d=it.d; return `<div class="mcard">${decoyThumb(d.img,d.d)}<div class="row2">${avatar(d.c,it.i)}<div class="txt"><div class="yt-title">${esc(d.t)}</div><div class="yt-chan">${esc(d.c)}</div><div class="yt-meta">${esc(d.v)} · ${esc(d.a)}</div></div></div></div>`;
    }).join("")+`</div></div></div>`;
  }
  function renderMobile(){ return mobileFeed(undefined); }
  function renderTV(){
    const cards=buildDeck(1).slice(0,8).map(it=>{
      if(it.mine) return `<div class="tvcard${mineCls()}">${badge()}${userThumb()}<div class="yt-title">${uTitle()}</div><div class="yt-meta">${uChan()} · ${esc(state.views)||"0 views"}</div></div>`;
      const d=it.d; return `<div class="tvcard">${decoyThumb(d.img,d.d)}<div class="yt-title">${esc(d.t)}</div><div class="yt-meta">${esc(d.c)} · ${esc(d.v)}</div></div>`;
    }).join("");
    return `<div class="tv"><div class="screen"><div class="tv-row-title">Recommended</div><div class="tv-scroll">${cards}</div></div></div>`;
  }
  function renderCompare(){
    if(state.thumbA==null && state.thumb) state.thumbA=state.thumb;
    const slot=(k,img)=>{const cls=k==='A'?'a':'b';const inner=img?`<img src="${img}" alt="Thumbnail ${k}"><div class="replace">Click to replace</div>`:`<div class="ph">Click to add <b>Thumbnail ${k}</b><br><small>JPG or PNG · 16:9</small></div>`;return `<div class="ab-slot" data-slot="${k}"><div class="ab-head"><span class="ab-badge ${cls}">${k}</span></div>${inner}</div>`;};
    return `<div class="cmp-uploads">${slot('A',state.thumbA)}${slot('B',state.thumbB)}</div>`+
      `<div class="cmp-phones">`+
        `<div class="cmp-col"><div class="ab-label"><span class="ab-badge a">A</span> Thumbnail A</div>${mobileFeed(state.thumbA,'ADD THUMBNAIL A ↑')}</div>`+
        `<div class="cmp-col"><div class="ab-label"><span class="ab-badge b">B</span> Thumbnail B</div>${mobileFeed(state.thumbB,'ADD THUMBNAIL B ↑')}</div>`+
      `</div>`;
  }
  function render(){
    const stage=document.getElementById("stage"), empty=document.getElementById("empty"), box=document.getElementById("render");
    stage.classList.toggle("light",state.light);
    if(!state.generated){empty.style.display="grid";box.innerHTML="";return;}
    empty.style.display="none";
    box.innerHTML=({desktop:renderDesktop,search:renderSearch,mobile:renderMobile,tv:renderTV,compare:renderCompare}[state.view]||renderDesktop)();
  }

  // ---- wiring ----
  const $=s=>document.querySelector(s);
  const drop=$("#drop"), thumbFile=$("#thumbFile");
  drop.addEventListener("click",()=>thumbFile.click());
  thumbFile.addEventListener("change",e=>readImg(e.target.files[0],u=>{state.thumb=u;showThumb(u);if(state.generated)render();}));
  ["dragover","dragenter"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add("drag");}));
  ["dragleave","dragend"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove("drag");}));
  drop.addEventListener("drop",e=>{e.preventDefault();drop.classList.remove("drag");const f=e.dataTransfer.files[0];if(f&&f.type.startsWith("image/"))readImg(f,u=>{state.thumb=u;showThumb(u);if(state.generated)render();});});
  function showThumb(u){drop.classList.add("filled");drop.innerHTML=`<img src="${u}" alt="thumbnail"><div class="replace">Click to replace</div>`;drop.appendChild(thumbFile);}

  const logoPick=$("#logoPick"), logoFile=$("#logoFile");
  function paintLogoPick(){ logoPick.innerHTML=`<img src="${state.logo}" alt="logo" onerror="this.remove();this.parentNode.textContent='J'">`; logoPick.appendChild(logoFile); }
  logoPick.addEventListener("click",()=>logoFile.click());
  logoFile.addEventListener("change",e=>readImg(e.target.files[0],u=>{state.logo=u;paintLogoPick();if(state.generated)render();}));

  function readImg(f,cb){if(!f)return;const r=new FileReader();r.onload=()=>cb(r.result);r.readAsDataURL(f);}

  const title=$("#title"),titleCount=$("#titleCount");
  function bind(id,key,extra){const el=$("#"+id);el.addEventListener("input",()=>{state[key]=el.value;if(extra)extra();if(state.generated)render();});}
  bind("title","title",()=>titleCount.textContent=title.value.length);
  bind("channel","channel");bind("duration","duration");bind("views","views");bind("age","age");
  $("#verified").addEventListener("change",e=>{state.verified=e.target.checked;if(state.generated)render();});

  $("#advToggle").addEventListener("click",function(){this.classList.toggle("open");$("#adv").classList.toggle("open");});

  document.querySelectorAll(".tab").forEach(tab=>tab.addEventListener("click",()=>{
    document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
    tab.classList.add("active");state.view=tab.dataset.view;state.generated=true;render();
  }));

  const themeBtn=$("#themeBtn");
  themeBtn.addEventListener("click",()=>{state.light=!state.light;themeBtn.innerHTML=state.light?"🌙 <span>Dark</span>":"☀️ <span>Light</span>";render();});
  $("#shuffleBtn").addEventListener("click",()=>{shuffle(deck);state.generated=true;render();});

  const hlBtn=$("#highlightBtn");
  hlBtn.addEventListener("click",()=>{state.highlight=!state.highlight;hlBtn.classList.toggle("on",state.highlight);hlBtn.innerHTML=state.highlight?"◉ Highlighted":"◎ Find mine";state.generated=true;render();});

  $("#generate").addEventListener("click",()=>{state.generated=true;render();document.getElementById("stage").scrollIntoView({behavior:"smooth",block:"start"});});

  $("#shotBtn").addEventListener("click",()=>{
    if(!state.generated){alert("Generate a preview first, then capture it.");return;}
    if(typeof html2canvas==="undefined"){alert("Screenshot library didn't load (you may be offline). Use your OS screenshot shortcut instead.");return;}
    const target=document.getElementById("stage");
    html2canvas(target,{backgroundColor:getComputedStyle(target).backgroundColor,scale:2,useCORS:true}).then(c=>{const a=document.createElement("a");a.download="thumbnail-preview.png";a.href=c.toDataURL("image/png");a.click();}).catch(()=>alert("Couldn't capture in this browser — use your OS screenshot shortcut."));
  });

  const fileA=$("#fileA"), fileB=$("#fileB");
  fileA.addEventListener("change",e=>readImg(e.target.files[0],u=>{state.thumbA=u;if(state.view==='compare')render();}));
  fileB.addEventListener("change",e=>readImg(e.target.files[0],u=>{state.thumbB=u;if(state.view==='compare')render();}));
  document.getElementById("render").addEventListener("click",e=>{const sl=e.target.closest(".ab-slot");if(sl)(sl.dataset.slot==='A'?fileA:fileB).click();});

  // init
  paintLogoPick();
  titleCount.textContent="0";
  render();
})();
</script>
</body>
</html>
